:host { display: block; }

.post-card {
  padding: 28rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,.76);
  box-shadow: 0 14rpx 34rpx rgba(86,72,57,.08);
  color: var(--text-color-primary);
  font-family: var(--font-family-base);
  font-weight: var(--font-weight-regular);
  letter-spacing: 0;
}

.post-head, .author-row, .calendar-title-row, .post-actions, .recruitment-content { display: flex; align-items: center; }
.post-head { justify-content: space-between; gap: 20rpx; }
.author-row { min-width: 0; gap: 18rpx; }
.avatar { width: 72rpx; height: 72rpx; flex: 0 0 72rpx; border-radius: 50%; background: #f2e8e3; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; font-size: var(--font-size-body); color: var(--text-color-primary); }
.author-copy { min-width: 0; display: flex; flex-direction: column; }
.author-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--font-size-body); line-height: var(--line-height-tight); }
.post-meta { margin-top: 5rpx; color: var(--text-color-muted); font-size: var(--font-size-caption); line-height: var(--line-height-normal); }
.icon-control { width: 64rpx; height: 64rpx; flex: 0 0 64rpx; display: flex; align-items: center; justify-content: center; }
.icon-control image { width: 36rpx; height: 36rpx; }
.public-text { display: block; margin-top: 24rpx; font-size: var(--font-size-body); line-height: var(--line-height-relaxed); white-space: pre-wrap; }

.record-content { position: relative; height: 390rpx; margin-top: 22rpx; overflow: hidden; border-radius: 12rpx; background: #f4ede8; }
.record-sticker { width: 100%; height: 318rpx; }
.record-caption { position: absolute; right: 24rpx; bottom: 18rpx; left: 24rpx; display: flex; justify-content: space-between; color: var(--text-color-muted); font-size: var(--font-size-caption); }

.calendar-content { margin-top: 22rpx; padding: 24rpx 18rpx 18rpx; border-radius: 12rpx; background: #f8f4ef; }
.calendar-title-row { justify-content: space-between; gap: 18rpx; margin-bottom: 18rpx; }
.content-title { font-size: var(--font-size-title); line-height: var(--line-height-tight); }
.calendar-month { color: var(--text-color-muted); font-family: var(--font-family-data); font-size: var(--font-size-secondary); }
.weekday-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.weekday-row text { padding-bottom: 10rpx; text-align: center; color: var(--text-color-muted); font-size: var(--font-size-caption); }
.calendar-cell { position: relative; min-width: 0; height: 72rpx; border-top: 1rpx solid rgba(120,108,97,.1); }
.calendar-cell.outside { opacity: .2; }
.calendar-day { position: absolute; top: 4rpx; left: 5rpx; z-index: 1; color: var(--text-color-muted); font-family: var(--font-family-data); font-size: var(--font-size-caption); }
.calendar-stickers { position: absolute; inset: 18rpx 2rpx 1rpx; display: flex; align-items: center; justify-content: center; }
.calendar-sticker { width: 32rpx; height: 32rpx; margin-left: -9rpx; }
.calendar-sticker:first-child { margin-left: 0; }
.member-strip { display: flex; flex-wrap: wrap; gap: 10rpx 18rpx; margin-top: 16rpx; }
.member-chip { display: flex; align-items: center; gap: 8rpx; color: var(--text-color-muted); font-size: var(--font-size-caption); }
.member-chip image, .member-dot { width: 28rpx; height: 28rpx; border-radius: 50%; background: #e3ada9; }

.board-content { position: relative; height: 500rpx; margin-top: 22rpx; overflow: hidden; border-radius: 12rpx; background: #efe4d9; }
.board-fallback { background: #eee3d8; }
.board-background { position: absolute; inset: 0; width: 100%; height: 100%; }
.board-item { position: absolute; }
.board-item image { width: 100%; height: 100%; }

.egg-content { min-height: 230rpx; margin-top: 22rpx; padding: 30rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 22rpx; border-radius: 12rpx; background: #f7e4e1; }
.egg-copy { min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.egg-kicker, .egg-sponsor { color: var(--text-color-muted); font-size: var(--font-size-secondary); }
.egg-image { width: 190rpx; height: 190rpx; flex: 0 0 190rpx; }
.egg-sparkle { width: 92rpx; height: 92rpx; flex: 0 0 92rpx; }

.recruitment-content { min-height: 180rpx; margin-top: 22rpx; padding: 28rpx; box-sizing: border-box; justify-content: space-between; gap: 24rpx; border-radius: 12rpx; background: #f0ebe5; }
.recruitment-main { min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.recruitment-copy { font-size: var(--font-size-body); line-height: var(--line-height-normal); }
.recruitment-meta { color: var(--text-color-muted); font-size: var(--font-size-secondary); }
.recruitment-chevron { width: 36rpx; height: 36rpx; flex: 0 0 36rpx; }

.post-actions { height: 66rpx; margin-top: 18rpx; border-top: 1rpx solid rgba(120,108,97,.1); padding-top: 14rpx; }
.action-control, .share-control { height: 58rpx; min-width: 0; flex: 1; padding: 0; margin: 0; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: 0; background: transparent; color: var(--text-color-muted); font-size: var(--font-size-secondary); font-weight: var(--font-weight-regular); line-height: var(--line-height-normal); }
.action-control.selected { color: var(--text-color-primary); }
.action-control image, .share-control image { width: 32rpx; height: 32rpx; }
.share-control::after { border: 0; }
.share-control:active { transform: none; opacity: .72; }
