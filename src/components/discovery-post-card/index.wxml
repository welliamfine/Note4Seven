<view class="post-card" bindtap="openPost" role="article">
  <view class="post-head">
    <view class="author-row">
      <image wx:if="{{post.author.avatarUrl}}" class="avatar" src="{{post.author.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-fallback">{{post.author.avatarText}}</view>
      <view class="author-copy">
        <text class="author-name">{{post.author.name}}</text>
        <text class="post-meta">{{post.typeLabel}} · {{post.timeLabel}}</text>
      </view>
    </view>
    <view class="icon-control" catchtap="openMore" role="button" aria-label="更多操作">
      <image src="/assets/ui/icons/ellipsis.svg" mode="aspectFit" />
    </view>
  </view>

  <text wx:if="{{post.publicText}}" class="public-text">{{post.publicText}}</text>

  <view wx:if="{{post.postType === 'record'}}" class="record-content">
    <image class="record-sticker sticker-outline-large" src="{{post.snapshot.stickerUrl}}" mode="aspectFit" webp />
    <view class="record-caption">
      <text>{{post.snapshot.moduleName}}</text>
      <text>{{post.snapshot.recordDate}}</text>
    </view>
  </view>

  <view wx:elif="{{post.postType === 'calendar'}}" class="calendar-content">
    <view class="calendar-title-row">
      <text class="content-title">{{post.snapshot.moduleName}}</text>
      <text class="calendar-month">{{post.snapshot.month}}</text>
    </view>
    <view class="weekday-row"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view>
    <view class="calendar-grid">
      <view class="calendar-cell {{item.inMonth ? '' : 'outside'}}" wx:for="{{post.calendarCells}}" wx:key="key">
        <text class="calendar-day">{{item.day}}</text>
        <view class="calendar-stickers">
          <image wx:for="{{item.records}}" wx:for-item="record" wx:key="stickerUrl" class="calendar-sticker sticker-outline-small" src="{{record.stickerUrl}}" mode="aspectFit" aria-label="{{record.memberName}}的记录" />
        </view>
      </view>
    </view>
    <view class="member-strip">
      <view class="member-chip" wx:for="{{post.snapshot.members}}" wx:key="memberKey">
        <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="member-dot"></view><text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{post.postType === 'board'}}" class="board-content {{post.snapshot.boardUrl ? '' : 'board-fallback'}}">
    <image wx:if="{{post.snapshot.boardUrl}}" class="board-background" src="{{post.snapshot.boardUrl}}" mode="scaleToFill" />
    <view class="board-item" wx:for="{{post.boardItems}}" wx:key="zIndex" style="{{item.style}}">
      <image class="sticker-outline-medium" src="{{item.imageUrl}}" mode="aspectFit" />
    </view>
  </view>

  <view wx:elif="{{post.postType === 'easter_egg'}}" class="egg-content">
    <view class="egg-copy">
      <text class="egg-kicker">{{post.snapshot.stage === 'redeemed' ? '已经兑换' : '刚刚解锁'}}</text>
      <text class="content-title">{{post.snapshot.title}}</text>
      <text class="egg-sponsor">来自 {{post.snapshot.sponsorName}}</text>
    </view>
    <image wx:if="{{post.snapshot.stickerUrl || post.snapshot.coverUrl}}" class="egg-image sticker-outline-medium" src="{{post.snapshot.stickerUrl || post.snapshot.coverUrl}}" mode="aspectFit" />
    <image wx:else class="egg-sparkle" src="/assets/ui/icons/sparkles.svg" mode="aspectFit" />
  </view>

  <view wx:elif="{{post.postType === 'module_recruitment'}}" class="recruitment-content" catchtap="openRecruitment" role="button">
    <view class="recruitment-main">
      <text class="content-title">{{post.snapshot.moduleName}}</text>
      <text class="recruitment-copy">{{post.snapshot.publicDescription}}</text>
      <text class="recruitment-meta">{{post.recruitmentStatusLabel}}</text>
    </view>
    <image class="recruitment-chevron" src="/assets/ui/icons/chevron-right.svg" mode="aspectFit" />
  </view>

  <view class="post-actions" catchtap="stop">
    <view class="action-control {{post.likedByViewer ? 'selected' : ''}}" catchtap="toggleLike" role="button" aria-label="{{post.likedByViewer ? '取消赞' : '赞'}}">
      <image src="/assets/ui/icons/heart.svg" mode="aspectFit" /><text>{{post.likeCount || post.actionLabel}}</text>
    </view>
    <view class="action-control" catchtap="openComments" role="button" aria-label="评论">
      <image src="/assets/ui/icons/message-circle.svg" mode="aspectFit" /><text>{{post.commentCount || '评论'}}</text>
    </view>
    <button class="share-control" open-type="share" data-post-id="{{post.postId}}" data-post-type="{{post.postType}}" aria-label="分享">
      <image src="/assets/ui/icons/share-2.svg" mode="aspectFit" /><text>分享</text>
    </button>
  </view>
</view>
