@import "../../styles/beta.wxss";
.recycle-list { display:flex; flex-direction:column; gap:20rpx; }.recycle-card { min-height:160rpx; padding:24rpx; display:flex; align-items:center; gap:18rpx; }.recycle-icon { flex:0 0 58rpx; width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(241,181,179,.28); }.recycle-icon image { width:28rpx; height:28rpx; opacity:.62; }.recycle-copy { min-width:0; flex:1; display:flex; flex-direction:column; gap:6rpx; }.recycle-copy text:first-child { color:var(--text-color-primary); font-size:var(--font-size-body); line-height:var(--line-height-normal); }.recycle-copy text:nth-child(2) { color:var(--signal-red); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }.recycle-copy text:last-child { color:var(--text-color-muted); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }.recycle-card button { width:104rpx; height:60rpx; margin:0; padding:0; display:flex; align-items:center; justify-content:center; border-radius:30rpx; background:rgba(255,255,255,.6); color:var(--text-color-primary); font-size:var(--font-size-secondary); font-weight:var(--font-weight-regular); line-height:var(--line-height-normal); }.beta-empty image { width:56rpx; height:56rpx; margin-bottom:18rpx; opacity:.35; }
