.discover-page { overflow: visible; }
.discover-header { position: fixed; top: 0; right: 0; left: 0; z-index: 8; height: 118rpx; padding-right: 32rpx; padding-left: 32rpx; box-sizing: content-box; display: flex; align-items: center; background: rgba(249,248,243,.88); backdrop-filter: blur(18px); }
.discover-title { font-size: var(--font-size-page-title); font-weight: var(--font-weight-regular); line-height: var(--line-height-tight); }
.discover-content { padding-right: 24rpx; padding-bottom: 40rpx; padding-left: 24rpx; }
.feed-list { display: flex; flex-direction: column; gap: 24rpx; }
.load-more { padding: 28rpx 0 12rpx; text-align: center; color: var(--text-color-muted); font-size: var(--font-size-caption); }

.loading-list { display: flex; flex-direction: column; gap: 24rpx; }
.loading-card { height: 500rpx; padding: 30rpx; box-sizing: border-box; border-radius: 16rpx; background: rgba(255,255,255,.68); }
.loading-card view { height: 24rpx; margin-bottom: 24rpx; border-radius: 8rpx; background: rgba(153,145,136,.12); }
.loading-card view:first-child { width: 52%; }
.loading-card view:nth-child(2) { width: 88%; }
.loading-card view:last-child { height: 310rpx; width: 100%; }

.state-panel { min-height: calc(100vh - 360rpx); padding: 40rpx 62rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.state-panel image { width: 88rpx; height: 88rpx; margin-bottom: 30rpx; opacity: .62; }
.empty-icon { position: relative; width: 88rpx; height: 88rpx; margin-bottom: 30rpx; overflow: hidden; opacity: .68; }
.empty-icon image { position: absolute; top: -88rpx; left: -176rpx; width: 352rpx; max-width: none; height: 176rpx; margin: 0; opacity: 1; }
.state-title { font-size: var(--font-size-title); line-height: var(--line-height-tight); }
.state-copy { max-width: 520rpx; margin-top: 18rpx; color: var(--text-color-muted); font-size: var(--font-size-secondary); line-height: var(--line-height-relaxed); }
.state-action { margin-top: 30rpx; padding: 16rpx 34rpx; border: 1rpx solid rgba(81,75,69,.16); border-radius: 8rpx; font-size: var(--font-size-body); }

.more-overlay { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(50,43,37,.32); }
.more-sheet { width: 100%; padding: 12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 16rpx 16rpx 0 0; background: #f9f8f3; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 2rpx auto 16rpx; border-radius: 4rpx; background: rgba(81,75,69,.18); }
.sheet-row { height: 92rpx; display: flex; align-items: center; justify-content: center; border-bottom: 1rpx solid rgba(120,108,97,.1); font-size: var(--font-size-body); }
.sheet-row.danger { color: var(--signal-red); }
.sheet-cancel { margin-top: 14rpx; border: 0; background: rgba(255,255,255,.68); }
