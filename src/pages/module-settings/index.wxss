@import "../../styles/beta.wxss";
.settings-form { padding:22rpx; }.save-info { margin-top:18rpx; }.settings-list button { width:100%; margin:0; border-radius:0; background:transparent; text-align:left; }
.settings-arrow { margin-left:auto; color:var(--text-color-muted); font-size:var(--font-size-title); }.exit-row { color:var(--signal-red); justify-content:center; }.creator-setting-note { padding:28rpx; color:var(--text-color-muted); font-size:var(--font-size-secondary); line-height:var(--line-height-relaxed); text-align:center; }
.reminder-card { padding:8rpx 22rpx 22rpx; }.reminder-row { min-height:106rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; border-bottom:1rpx solid rgba(112,99,87,.08); }.reminder-row > view { display:flex; flex-direction:column; padding-left:12rpx; }.reminder-row > view text,.settings-option-title,.settings-list .beta-row > text:first-child { color:var(--text-color-primary); font-size:var(--font-size-title); font-weight:var(--font-weight-regular); line-height:var(--line-height-tight); }.reminder-value { color:var(--text-color-primary); font-family:var(--font-family-data); font-size:var(--font-size-title); font-weight:var(--font-weight-regular); line-height:var(--line-height-tight); }.subscription-reminder-row > view { flex:1; min-width:0; align-items:flex-start; }.settings-option-title,.settings-list .beta-row > text:first-child { margin-left:12rpx; }.reminder-save { margin-top:20rpx; }.delete-hint { display:block; margin:-8rpx 4rpx 20rpx; color:var(--text-color-muted); font-size:var(--font-size-secondary); line-height:var(--line-height-relaxed); }.delete-error { display:block; margin:10rpx 5rpx 0; color:var(--signal-red); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }.delete-confirm { margin-top:22rpx; }
