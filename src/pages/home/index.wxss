@import "../memory/index.wxss";
@import "../discover/index.wxss";
@import "../profile/index.wxss";
@import "../../styles/beta.wxss";

page {
  height: 100%;
  overflow: hidden;
}

.primary-swiper,
.primary-swiper-item,
.primary-scroll {
  width: 100%;
  height: 100vh;
}

.primary-swiper {
  overflow: hidden;
  background: #f9f8f3;
}

.primary-swiper-item {
  overflow: hidden;
}

.primary-scroll {
  display: block;
}

.primary-swiper .page-texture {
  position: absolute;
}

.memory-page .page-title {
  font-size: var(--font-size-page-title);
  font-weight: var(--font-weight-regular);
  line-height: var(--line-height-tight);
}

.profile-page .page-title {
  font-size: var(--font-size-page-title);
  font-weight: var(--font-weight-regular);
  line-height: var(--line-height-tight);
}

.home {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  max-height: 100vh;
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f9f8f3;
  background-image: none;
}

.home-top,
.skeleton-list,
.empty-home,
.module-groups {
  position: relative;
  z-index: 1;
}

.home-top {
  position: relative;
  flex: 0 0 auto;
  min-height: 142rpx;
  padding-left: 38rpx;
  padding-right: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-module-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
}

.home-brand {
  display: flex;
  flex-direction: column;
}

.manage-pill {
  position: absolute;
  right: 36rpx;
  bottom: 18rpx;
  width: 112rpx;
  height: 62rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 31rpx;
  background: rgba(255, 255, 255, 0.4);
  box-shadow:
    inset 0 15px 30px rgba(255, 255, 255, 0.2),
    inset 0 0 15px rgba(255, 255, 255, 0.2),
    inset 0 1px 1px rgba(255, 255, 255, 0.5),
    inset 0 2px 2px rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(30px);
  color: var(--text-color-primary);
  font-size: var(--font-size-secondary);
  font-weight: var(--font-weight-regular);
  line-height: var(--line-height-normal);
}

.module-groups,
.skeleton-list {
  padding: 0 38rpx calc(230rpx + env(safe-area-inset-bottom));
}

.module-group {
  margin-bottom: 34rpx;
}

.normal-group {
  margin-top: 18rpx;
}

.group-heading {
  width: 100%;
  height: 54rpx;
  margin: 0;
  padding: 0 2rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: transparent;
  color: var(--text-color-primary);
  font-size: var(--font-size-secondary);
  font-weight: var(--font-weight-regular);
  text-align: left;
  line-height: var(--line-height-tight);
  box-sizing: border-box;
}

.group-chevron {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.64;
  transition: transform 180ms cubic-bezier(.22,1,.36,1);
}

.group-toggle {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.chevron-open {
  transform: rotate(180deg);
}

.group-list {
  position: relative;
  overflow: hidden;
}

.pin-layout-active .group-list {
  overflow: visible;
}

.pin-motion-active {
  pointer-events: none;
}

.group-list-opening {
  transition: height var(--group-opening-duration) cubic-bezier(.22,1,.36,1);
  pointer-events: none;
}

.group-list-opening .module-card {
  transition: transform var(--group-card-opening-duration) cubic-bezier(.22,1,.36,1), opacity var(--group-card-opening-duration) ease-out;
  transition-delay: var(--expand-delay);
  transform-origin: left top;
}

.group-list-opening .collapse-order-0 { z-index: 3; }
.group-list-opening .collapse-order-1 { z-index: 2; }
.group-list-opening .collapse-order-2 { z-index: 1; }
.group-list-opening .collapse-order-overflow { z-index: 0; }

.group-list-closing {
  height: 266rpx !important;
  transition: height var(--group-motion-duration) cubic-bezier(.22,1,.36,1);
  pointer-events: none;
}

.group-list-closing .module-card,
.group-list-collapsed .module-card {
  transition: transform var(--group-motion-duration) cubic-bezier(.22,1,.36,1), opacity var(--group-motion-duration) ease-out;
  transform-origin: left top;
  transform: translateY(var(--collapse-y));
}

.group-list-closing .collapse-order-0,
.group-list-collapsed .collapse-order-0 {
  z-index: 3;
}

.group-list-closing .collapse-order-1,
.group-list-collapsed .collapse-order-1 {
  z-index: 2;
  transform: translate(6rpx, var(--collapse-y)) scaleX(.966) rotate(-.7deg);
}

.group-list-closing .collapse-order-2,
.group-list-collapsed .collapse-order-2 {
  z-index: 1;
  transform: translate(18rpx, var(--collapse-y)) scaleX(.966) rotate(1deg);
}

.group-list-closing .collapse-order-overflow,
.group-list-collapsed .collapse-order-overflow {
  z-index: 0;
  opacity: 0;
}

.module-card {
  position: relative;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 224rpx;
  min-height: 224rpx;
  max-height: 224rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  flex: 0 0 224rpx;
  overflow: hidden;
  border-radius: 46rpx;
  background: rgba(255, 255, 255, 0.4);
  box-shadow:
    inset 0 15px 30px rgba(255, 255, 255, 0.2),
    inset 0 0 15px rgba(255, 255, 255, 0.2),
    inset 0 1px 1px rgba(255, 255, 255, 0.5),
    inset 0 2px 2px rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(30px);
  transition:
    width 220ms cubic-bezier(.22,1,.36,1),
    min-width 220ms cubic-bezier(.22,1,.36,1),
    max-width 220ms cubic-bezier(.22,1,.36,1),
    transform 220ms cubic-bezier(.22,1,.36,1);
}

.module-card-content {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 224rpx;
  padding: 30rpx 30rpx 30rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  border-radius: 46rpx;
  transform: translate3d(0, 0, 0);
  backface-visibility: hidden;
}

.home-managing .module-groups {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.home-managing .module-card {
  width: calc(100% - 76rpx);
  min-width: calc(100% - 76rpx);
  max-width: calc(100% - 76rpx);
  overflow: visible;
  transform: translateX(76rpx);
}

.module-select {
  position: absolute;
  left: -64rpx;
  top: 88rpx;
  z-index: 12;
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(112, 101, 92, .38);
  border-radius: 50%;
  background: rgba(255, 255, 255, .58);
  color: #fff;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-regular);
  line-height: 1;
}

.module-select-checked {
  border-color: #d99d98;
  background: #d99d98;
}

.module-select text {
  transform: translateY(-1rpx);
}

.module-selected {
  background: rgba(250, 238, 235, .72);
  box-shadow:
    inset 0 0 0 3rpx rgba(217, 157, 152, .34),
    inset 0 15px 30px rgba(255, 255, 255, .22),
    inset 0 2px 2px rgba(255, 255, 255, .7);
}

.pin-popover-open {
  z-index: 20;
}

.pin-popover {
  position: absolute;
  top: 18rpx;
  right: 20rpx;
  z-index: 30;
  min-width: 128rpx;
  height: 58rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(84, 77, 71, .94);
  box-shadow: 0 10rpx 24rpx rgba(55, 47, 40, .18);
  color: #fff;
  font-size: var(--font-size-caption);
  line-height: var(--line-height-normal);
  animation: pin-popover-enter 160ms cubic-bezier(.22,1,.36,1) both;
}

.pin-popover::after {
  content: '';
  position: absolute;
  right: 24rpx;
  bottom: -10rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 11rpx solid rgba(84, 77, 71, .94);
}

@keyframes pin-popover-enter {
  from { opacity: 0; transform: translateY(8rpx) scale(.92); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.group-list .home-card-leaving {
  pointer-events: none;
  transform-origin: center center;
  animation: sticker-point-pop var(--pin-leave-duration) cubic-bezier(.22,1,.36,1) reverse both;
}

.group-list .home-card-gap {
  pointer-events: none;
  opacity: 0;
  transform: scale(.06);
}

.group-list .home-card-entering {
  pointer-events: none;
  transform-origin: center center;
  animation: sticker-point-pop var(--pin-enter-duration) cubic-bezier(.22,1,.36,1) both;
}

.group-list .pin-layout-positioned {
  transform: translateY(var(--pin-layout-y));
  transition: none;
}

.group-list .pin-layout-shifting {
  transform: translateY(0);
  transition: transform var(--pin-layout-duration) cubic-bezier(.22,1,.36,1);
}

.home-managing .group-list .pin-layout-positioned {
  transform: translate3d(76rpx, var(--pin-layout-y), 0);
}

.home-managing .group-list .pin-layout-shifting {
  transform: translate3d(76rpx, 0, 0);
}

.normal-group.pin-group-positioned {
  transform: translateY(var(--pin-group-y));
  transition: none;
}

.normal-group.pin-group-shifting {
  transform: translateY(0);
  transition: transform var(--pin-layout-duration) cubic-bezier(.22,1,.36,1);
}

.card-copy {
  width: 42%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 22rpx;
  z-index: 6;
}

.module-name-row {
  position: relative;
  top: 8rpx;
  display: flex;
  align-items: center;
  min-width: 0;
}

.module-name {
  max-width: 260rpx;
  margin-left: 14rpx;
  font-family: var(--font-family-base);
  font-size: var(--font-size-title);
  font-weight: 400;
  font-synthesis: none;
  line-height: var(--line-height-tight);
  word-break: break-all;
}

.module-unread-dot {
  flex: 0 0 14rpx;
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: var(--signal-red);
}

.avatar-stack {
  display: flex;
  align-items: center;
  padding-left: 2rpx;
  transform: translateY(10rpx);
}

.mini-avatar {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  overflow: hidden;
  color: #fff;
  font-size: var(--font-size-secondary);
  line-height: 46rpx;
  text-align: center;
}

.mini-avatar image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.sticker-stack {
  position: relative;
  flex: 1;
  min-width: 0;
  transform: translateX(-30rpx);
}

.stack-sticker-position {
  position: absolute;
  top: -8rpx;
  width: 150rpx;
  height: 170rpx;
}

.stack-sticker-content {
  width: 100%;
  height: 100%;
}

.sticker-0 { transform: rotate(-4deg); }
.sticker-1 { transform: rotate(3deg); }
.sticker-2 { transform: rotate(-2deg); }
.sticker-3 { transform: rotate(4deg); }

.quiet-label {
  position: absolute;
  right: 2rpx;
  top: 72rpx;
  color: var(--text-color-muted);
  font-size: var(--font-size-secondary);
}

.floating-add {
  position: fixed;
  right: 40rpx;
  bottom: calc(190rpx + env(safe-area-inset-bottom));
  z-index: 90;
  width: 104rpx;
  min-width: 0;
  height: 104rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  box-shadow:
    inset 0 15px 30px rgba(255, 255, 255, 0.2),
    inset 0 0 15px rgba(255, 255, 255, 0.2),
    inset 0 1px 1px rgba(255, 255, 255, 0.5),
    inset 0 2px 2px rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(30px);
}

.home-state-icon {
  position: relative;
  flex: none;
  width: 40rpx;
  height: 40rpx;
  overflow: hidden;
}

.floating-add .home-state-icon {
  width: 84rpx;
  height: 84rpx;
}

.record-policy-option .home-state-icon {
  width: 58rpx;
  height: 58rpx;
}

.home-state-icon-sprite {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 200%;
  max-width: none;
  height: 100%;
}

.floating-add.control-pressed .home-state-icon-sprite {
  transform: translateX(-50%);
}

.manage-toolbar {
  position: fixed;
  right: 38rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 96;
  width: 172rpx;
  height: 72rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.manage-delete {
  width: 172rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 36rpx;
  background: var(--signal-red);
  color: #fff;
  font-size: var(--font-size-secondary);
  font-weight: var(--font-weight-regular);
  line-height: 72rpx;
}

.manage-delete::after { border: 0; }
.manage-delete[disabled] { opacity: .38; }
.manage-delete image { width: 28rpx; height: 28rpx; filter: brightness(0) invert(1); }

.skeleton {
  height: 224rpx;
  margin: 22rpx 0;
  border-radius: 46rpx;
  background: rgba(255, 255, 255, .44);
}

.empty-home {
  min-height: 62vh;
  padding: 50rpx 58rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-sticker { width: 230rpx; height: 186rpx; }
.empty-sticker image { width: 100%; height: 100%; }
.empty-title { margin-top:20rpx; color:var(--text-color-primary); font-size:var(--font-size-title); font-weight:var(--font-weight-regular); line-height:var(--line-height-tight); }
.empty-button { width: 100%; margin-top: 46rpx; }

.overlay {
  position: fixed;
  inset: 0;
  z-index: 110;
  display: flex;
  align-items: flex-end;
  background: rgba(93, 83, 73, 0.1);
  backdrop-filter: blur(15px);
}

.create-sheet {
  width: 100%;
  height: 67vh;
  min-height: 570rpx;
  padding: 12rpx 34rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.glass-sheet {
  border-radius: 52rpx 52rpx 0 0;
  background: rgba(255, 255, 255, 0.4);
  box-shadow:
    inset 0 15px 30px rgba(255, 255, 255, 0.2),
    inset 0 0 15px rgba(255, 255, 255, 0.2),
    inset 0 1px 1px rgba(255, 255, 255, 0.5),
    inset 0 2px 2px rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(30px);
}

.record-policy-help-overlay {
  z-index: 130;
  background: rgba(75, 66, 58, .16);
}

.record-policy-help-sheet {
  width: 100%;
  padding: 12rpx 34rpx calc(26rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.record-policy-help-content {
  margin-top: 20rpx;
}

.record-policy-help-row {
  padding: 22rpx 4rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border-bottom: 1rpx solid rgba(111, 98, 86, .09);
}

.record-policy-help-name {
  color: var(--text-color-primary);
  font-size: var(--font-size-body);
  line-height: var(--line-height-tight);
}

.record-policy-help-copy {
  color: var(--text-color-muted);
  font-size: var(--font-size-secondary);
  line-height: var(--line-height-relaxed);
}

.record-policy-help-warning {
  display: block;
  margin: 22rpx 4rpx 20rpx;
  color: var(--signal-red);
  font-size: var(--font-size-secondary);
  line-height: var(--line-height-normal);
  text-align: center;
}

.record-policy-help-confirm {
  height: 82rpx;
}

.sheet-handle {
  width: 62rpx;
  height: 7rpx;
  margin: 0 auto 20rpx;
  border-radius: 4rpx;
  background: rgba(158, 149, 140, .18);
}

.sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  color: var(--text-color-primary);
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-regular);
  line-height: var(--line-height-tight);
}

.close-button {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: rgba(255, 255, 255, .76);
}

.close-button image { width: 22rpx; height: 22rpx; opacity: .62; }

.create-content {
  flex: 1;
  min-height: 0;
  margin-top: 24rpx;
}

.text-input,
.description-input {
  width: 100%;
  box-sizing: border-box;
  border: 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: none;
  backdrop-filter: blur(30px);
  color: var(--text-color-primary);
  font-size: var(--font-size-secondary);
  font-weight: var(--font-weight-regular);
  line-height: var(--line-height-normal);
}

.text-input {
  height: 82rpx;
  padding: 0 24rpx;
}

.description-input {
  min-height: 138rpx;
  margin-top: 18rpx;
  padding: 25rpx 24rpx;
}

.record-policy-heading {
  margin: 28rpx 2rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-color-primary);
  font-size: var(--font-size-secondary);
  line-height: var(--line-height-normal);
}

.record-policy-help {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.record-policy-help image {
  width: 28rpx;
  height: 28rpx;
  opacity: .52;
}

.record-policy-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.record-policy-option {
  height: 76rpx;
  min-width: 0;
  padding: 0 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .56);
}

.record-policy-selected {
  border-color: rgba(214, 139, 134, .62);
  background: rgba(245, 222, 219, .72);
}

.record-policy-title {
  color: var(--text-color-primary);
  font-size: var(--font-size-secondary);
  line-height: var(--line-height-tight);
  text-align: center;
}

.template-heading {
  margin: 28rpx 0 16rpx;
  color: var(--text-color-primary);
  font-size: var(--font-size-secondary);
  line-height: var(--line-height-normal);
}

.template-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.template-pill {
  height: 54rpx;
  margin: 0;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 27rpx;
  background: rgba(255, 255, 255, .8);
  color: var(--text-color-primary);
  font-size: var(--font-size-secondary);
  font-weight: var(--font-weight-regular);
  line-height: var(--line-height-normal);
}

.template-selected {
  background: #f5dedb;
  color: var(--text-color-primary);
}

.form-error {
  display: block;
  margin: 16rpx 2rpx;
  color: var(--signal-red);
  font-size: var(--font-size-secondary);
  line-height: var(--line-height-normal);
}

.create-submit {
  flex: 0 0 var(--bottom-action-height);
  margin-top: 18rpx;
}

.create-sheet.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
