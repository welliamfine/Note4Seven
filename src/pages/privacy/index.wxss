@import "../../styles/beta.wxss";
.privacy-card { padding:34rpx; display:flex; flex-direction:column; gap:20rpx; color:var(--text-color-primary); font-size:var(--font-size-secondary); font-weight:var(--font-weight-regular); line-height:var(--line-height-relaxed); }.privacy-card image { width:52rpx; height:52rpx; opacity:.62; }.privacy-card .privacy-title { color:var(--text-color-primary); font-size:var(--font-size-title); font-weight:var(--font-weight-regular); line-height:var(--line-height-tight); }.deletion-state { margin-top:26rpx; padding:28rpx; display:flex; flex-direction:column; gap:12rpx; }.deletion-state text:first-child { color:var(--signal-red); font-size:var(--font-size-body); }.deletion-state text:nth-child(2) { color:var(--text-color-muted); font-size:var(--font-size-caption); }.deletion-state button { margin-top:12rpx; }.delete-account { height:76rpx; margin:34rpx 0 0; display:flex; align-items:center; justify-content:center; background:transparent; color:var(--signal-red); font-size:var(--font-size-secondary); font-weight:var(--font-weight-regular); line-height:var(--line-height-normal); }
