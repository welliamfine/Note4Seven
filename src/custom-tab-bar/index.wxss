.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 18rpx;
  z-index: 80;
  pointer-events: none;
}

.tab-pill {
  height: 124rpx;
  margin: 0 32rpx 20rpx;
  padding: 8rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  border: 0;
  border-radius: 62rpx;
  background: rgba(255, 255, 255, 0.4);
  box-shadow:
    inset 0 15px 30px rgba(255, 255, 255, 0.2),
    inset 0 0 15px rgba(255, 255, 255, 0.2),
    inset 0 1px 1px rgba(255, 255, 255, 0.5),
    inset 0 2px 2px rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(30px);
  pointer-events: auto;
}

.tab-item {
  flex: 0 0 25%;
  width: 25%;
  min-width: 0;
  height: 100%;
  margin: 0;
  padding: 8rpx 0 6rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #5b5651;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1;
}

.tab-icon-wrap {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
}

.tab-icon-clip {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.tab-item .tab-icon-sprite {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 232rpx;
  max-width: none;
  height: 116rpx;
}

.tab-item .tab-icon-sprite-1 { left: -58rpx; }
.tab-item .tab-icon-sprite-2 { left: -116rpx; }
.tab-item .tab-icon-sprite-3 { left: -174rpx; }
.tab-item .tab-icon-sprite-selected { top: -58rpx; }

.tab-item .tab-unread-dot {
  position: absolute;
  top: -3rpx;
  right: -5rpx;
  width: 13rpx;
  height: 13rpx;
  margin: 0;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: #ff5a5f;
}

.tab-item text {
  margin-top: 6rpx;
}

.tab-active { color: #dfa8a5; }
