.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 18rpx;
  z-index: 80;
  pointer-events: none;
}

.tab-pill {
  height: 104rpx;
  margin: 0 32rpx 20rpx;
  padding: 8rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  border: 0;
  border-radius: 52rpx;
  background: rgba(255, 255, 255, 0.05);
  box-shadow:
    inset 0 15px 30px rgba(255, 255, 255, 0.2),
    inset 0 0 15px rgba(255, 255, 255, 0.2),
    inset 0 1px 1px rgba(255, 255, 255, 0.5),
    inset 0 2px 2px rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(30px);
  pointer-events: auto;
}

.tab-item {
  flex: 0 0 25%;
  width: 25%;
  min-width: 0;
  height: 100%;
  margin: 0;
  padding: 10rpx 0 6rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #5b5651;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1;
}

.tab-icon-wrap {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
}

.tab-item image {
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0.78;
}

.tab-item .tab-unread-dot {
  position: absolute;
  top: -5rpx;
  right: -7rpx;
  width: 13rpx;
  height: 13rpx;
  margin: 0;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: #ff5a5f;
}

.tab-item text {
  margin-top: 5rpx;
}

.tab-active { color: #dfa8a5; }

.tab-active image {
  opacity: 0.42;
  filter: sepia(1) saturate(1.2) hue-rotate(305deg);
}
