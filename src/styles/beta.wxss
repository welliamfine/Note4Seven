.beta-page {
  height: 100vh;
  min-height: 0;
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.beta-topbar {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  padding: 16rpx 34rpx 20rpx;
}

.beta-brand {
  display: block;
  text-align: center;
}

.beta-heading {
  min-height: 76rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.beta-heading-title {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-regular);
  line-height: var(--line-height-tight);
  text-align: center;
}

.beta-back,
.beta-icon-button {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,.4);
  box-shadow: inset 0 15rpx 30rpx rgba(255,255,255,.2), inset 0 0 15rpx rgba(255,255,255,.2), inset 0 1rpx 1rpx rgba(255,255,255,.5), inset 0 2rpx 2rpx rgba(255,255,255,.7), 0 8rpx 18rpx rgba(66,54,44,.08);
  backdrop-filter: blur(30px);
}

.beta-back image,
.beta-icon-button image { width: 28rpx; height: 28rpx; opacity: .72; }

.beta-scroll { flex: 1; min-height: 0; }
.beta-body { padding: 12rpx 36rpx calc(150rpx + env(safe-area-inset-bottom)); }

.beta-glass {
  border: 1rpx solid rgba(255,255,255,.45);
  border-radius: 38rpx;
  background: rgba(255,255,255,.4);
  box-shadow: inset 0 15rpx 30rpx rgba(255,255,255,.2), inset 0 0 15rpx rgba(255,255,255,.2), inset 0 1rpx 1rpx rgba(255,255,255,.5), inset 0 2rpx 2rpx rgba(255,255,255,.7), 0 12rpx 30rpx rgba(68,56,45,.07);
  backdrop-filter: blur(30px);
}

.beta-section-title { display:block; margin:30rpx 8rpx 15rpx; color:var(--text-color-primary); font-size:var(--font-size-secondary); font-weight:var(--font-weight-regular); line-height:var(--line-height-tight); }
.beta-muted { color:var(--text-color-muted); }

.beta-row {
  min-height: 108rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(111,98,86,.08);
}
.beta-row:last-child { border-bottom: 0; }

.beta-avatar {
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  border: 3rpx solid rgba(255,255,255,.75);
  border-radius: 50%;
  font-size: var(--font-size-title);
  line-height: 68rpx;
  text-align: center;
}

.beta-avatar image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.beta-row-copy { min-width:0; flex:1; display:flex; flex-direction:column; gap:6rpx; }
.beta-row-title { color:var(--text-color-primary); font-size:var(--font-size-body); font-weight:var(--font-weight-regular); line-height:var(--line-height-normal); }
.beta-row-subtitle { color:var(--text-color-muted); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }
.beta-tag { padding:6rpx 12rpx; border-radius:18rpx; background:rgba(235,213,207,.65); color:var(--text-color-primary); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }
.beta-status-good { color:var(--text-color-primary); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }
.beta-status-muted { color:var(--text-color-muted); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }

.beta-fixed-action {
  position: fixed;
  left: 38rpx;
  right: 38rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.beta-primary,
.beta-secondary,
.beta-danger {
  width:100%;
  height:88rpx;
  margin:0;
  padding:0;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:44rpx;
  font-size: var(--font-size-body);
  font-weight:var(--font-weight-regular);
  line-height:var(--line-height-normal);
}
.beta-primary { background:rgba(255,255,255,.82); color:var(--text-color-primary); box-shadow:0 12rpx 28rpx rgba(76,62,50,.1); }
.beta-secondary { background:rgba(255,255,255,.42); color:var(--text-color-primary); }
.beta-danger { background:var(--signal-red); color:#fff; }
.beta-primary[disabled], .beta-secondary[disabled] { opacity:.45; }

.beta-primary.bottom-action-button,
.beta-secondary.bottom-action-button,
.beta-danger.bottom-action-button {
  flex: 0 0 var(--bottom-action-height);
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: var(--bottom-action-height);
  padding: 0 var(--bottom-action-padding);
  box-sizing: border-box;
  border-radius: var(--bottom-action-radius);
  font-size: var(--font-size-body);
  line-height: var(--line-height-normal);
  text-align: center;
}

.beta-primary.bottom-action-button {
  box-shadow: 0 12rpx 30rpx rgba(74,63,51,.1);
}

.beta-secondary.bottom-action-button {
  background: rgba(255,255,255,.68);
  box-shadow: 0 10rpx 24rpx rgba(74,63,51,.07);
}

.beta-fixed-action.bottom-action-bar {
  left: 26rpx;
  right: 26rpx;
  bottom: 18rpx;
  padding: 16rpx 0 calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.beta-overlay {
  position:fixed;
  inset:0;
  z-index:80;
  display:flex;
  align-items:flex-end;
  background:rgba(59,51,45,.12);
  backdrop-filter:blur(14px);
}

.beta-sheet {
  width:100%;
  padding:14rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  border-radius:50rpx 50rpx 0 0;
  background:rgba(255,255,255,.4);
  box-shadow:inset 0 15rpx 30rpx rgba(255,255,255,.2), inset 0 0 15rpx rgba(255,255,255,.2), inset 0 1rpx 1rpx rgba(255,255,255,.5), inset 0 2rpx 2rpx rgba(255,255,255,.7);
  backdrop-filter:blur(30px);
}
.beta-handle { width:68rpx; height:7rpx; margin:0 auto 22rpx; border-radius:4rpx; background:rgba(102,92,83,.12); }
.beta-sheet-title { display:block; margin:0 4rpx 24rpx; color:var(--text-color-primary); font-size:var(--font-size-title); font-weight:var(--font-weight-regular); line-height:var(--line-height-tight); }
.beta-sheet-actions { display:flex; flex-direction:column; gap:16rpx; }
.beta-empty { min-height:360rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; color:var(--text-color-muted); font-size:var(--font-size-secondary); line-height:var(--line-height-normal); text-align:center; }
.beta-loading { padding:100rpx 0; color:var(--text-color-muted); text-align:center; }

.beta-input,
.beta-textarea {
  width:100%;
  box-sizing:border-box;
  border:0;
  background:rgba(255,255,255,.5);
  backdrop-filter:blur(30px);
  color:var(--text-color-primary);
  font-size: var(--font-size-secondary);
  font-weight:var(--font-weight-regular);
  line-height:var(--line-height-normal);
}
.beta-input { height:82rpx; padding:0 24rpx; border-radius:28rpx; }
.beta-textarea { min-height:82rpx; margin-top:16rpx; padding:22rpx 24rpx; border-radius:30rpx; line-height:var(--line-height-relaxed); }
