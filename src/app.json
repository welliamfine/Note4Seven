{
  "pages": [
    "pages/home/index",
    "pages/memory/index",
    "pages/discover/index",
    "pages/profile/index"
  ],
  "subPackages": [
    {
      "name": "features",
      "root": "subpackages",
      "pages": [
        "module-detail/index",
        "member-management/index",
        "invite-share/index",
        "invite-intro/index",
        "module-settings/index",
        "notifications/index",
        "module-todo/index",
        "module-gallery/index",
        "memory-collage-editor/index",
        "reward-collection/index",
        "discover-post/index",
        "discover-publish/index",
        "discover-recruitment/index",
        "recycle-bin/index",
        "privacy/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/index": {
      "network": "wifi",
      "packages": ["features"]
    }
  },
  "window": {
    "navigationStyle": "custom",
    "backgroundColor": "#f9f8f3",
    "backgroundTextStyle": "dark"
  },
  "usingComponents": {
    "privacy-dialog": "/components/privacy-dialog/index"
  },
  "tabBar": {
    "custom": true,
    "color": "#8a8c86",
    "selectedColor": "#e3ada9",
    "backgroundColor": "#f9f8f3",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/home/index", "text": "首页" },
      { "pagePath": "pages/memory/index", "text": "回忆" },
      { "pagePath": "pages/discover/index", "text": "发现" },
      { "pagePath": "pages/profile/index", "text": "我的" }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
