@import "../../styles/beta.wxss";
.mark-all { width:90rpx; margin:0; padding:0; display:flex; align-items:center; justify-content:center; background:transparent; color:var(--text-color-primary); font-size:var(--font-size-caption); font-weight:var(--font-weight-regular); line-height:var(--line-height-normal); }
.notification-body { padding-top:4rpx; }.notification-list { display:flex; flex-direction:column; gap:20rpx; }.notification-card { position:relative; padding:26rpx 28rpx; }
.notification-head { position:relative; min-height:42rpx; padding-right:44rpx; display:flex; align-items:center; }.notification-title { color:var(--text-color-primary); font-size:var(--font-size-body); line-height:var(--line-height-normal); }.unread-dot { position:absolute; top:50%; right:8rpx; width:14rpx; height:14rpx; border-radius:50%; background:var(--signal-red); transform:translateY(-50%); }
.notification-content { display:block; margin-top:12rpx; color:var(--text-color-muted); font-size:var(--font-size-secondary); line-height:var(--line-height-normal); }.notification-time { display:block; margin-top:13rpx; color:var(--text-color-muted); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }
.notification-actions { width:100%; margin-top:22rpx; box-sizing:border-box; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14rpx; }.notification-actions button { width:100%; min-width:0; height:68rpx; margin:0; padding:0; box-sizing:border-box; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:34rpx; background:rgba(255,255,255,.52); color:var(--text-color-primary); font-size:var(--font-size-secondary); font-weight:var(--font-weight-regular); line-height:var(--line-height-normal); }.notification-actions .approve { background:#d7c2ae; color:#fff; }
.notification-result { display:block; margin-top:16rpx; color:var(--text-color-muted); font-size:var(--font-size-caption); line-height:var(--line-height-normal); text-align:right; }
