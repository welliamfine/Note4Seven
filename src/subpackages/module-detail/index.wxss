.reward-sponsor-chip text:first-child { color:#8c8278; font-size:20rpx; }
.reward-sponsor-chip text:last-child { color:#5b524b; font-size:25rpx; }
.reward-card-open { position:absolute; bottom:44rpx; width:410rpx; height:92rpx; margin:0; border-radius:46rpx; background:rgba(240,209,204,.88); box-shadow:0 10rpx 24rpx rgba(98,72,66,.13),inset 0 2rpx 1rpx rgba(255,255,255,.7); color:#5b524b; font-size:27rpx; font-weight:400; }
.reward-code-row { position:absolute; top:40rpx; right:32rpx; left:32rpx; display:flex; align-items:center; justify-content:space-between; color:#c4948f; font-family:serif; font-size:20rpx; }
.reward-result-kicker { position:relative; margin-top:60rpx; color:#5b524b; font-family:serif; font-size:32rpx; line-height:1.25; text-align:center; }
.reward-result-sticker { position:relative; width:280rpx; height:306rpx; margin-top:28rpx; filter:drop-shadow(0 13rpx 26rpx rgba(64,51,43,.12)); }
.reward-result-title { position:relative; max-width:100%; margin-top:20rpx; color:#5b524b; font-family:serif; font-size:34rpx; line-height:1.3; text-align:center; overflow-wrap:anywhere; }
.reward-result-source { position:relative; max-width:100%; margin-top:9rpx; color:#8c8278; font-size:20rpx; text-align:center; }
.reward-result-description { position:relative; max-width:100%; margin-top:10rpx; color:#8c8278; font-size:22rpx; line-height:1.5; text-align:center; overflow-wrap:anywhere; }
.reward-result-date { position:absolute; bottom:31rpx; color:#8c8278; font-family:serif; font-size:20rpx; }
.reward-open-button { width:374rpx; height:90rpx; margin:28rpx 0 0; display:flex; align-items:center; justify-content:center; border-radius:45rpx; background:rgba(255,255,255,.8); box-shadow:0 12rpx 28rpx rgba(72,60,52,.14),inset 0 2rpx 2rpx rgba(255,255,255,.78); color:#5b524b; font-size:27rpx; font-weight:400; line-height:1; }
.reward-finish-button { background:rgba(242,214,209,.9); }
.reward-stack-tip { margin-top:12rpx; color:rgba(255,255,255,.9); font-size:21rpx; }
.reward-batch-panel { width:100%; max-width:650rpx; display:flex; flex-direction:column; align-items:center; }
.reward-batch-title { margin-bottom:22rpx; color:#fff; font-family:serif; font-size:34rpx; }
.reward-batch-scroll { max-height:69vh; }
.reward-batch-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; padding:10rpx 4rpx 22rpx; }
.reward-mini-card { position:relative; height:430rpx; padding:26rpx 18rpx; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; overflow:hidden; border-radius:28rpx; background:#fffcf7; box-shadow:0 14rpx 28rpx rgba(56,46,38,.18); }
.reward-mini-kicker { position:relative; color:#c4948f; font-family:serif; font-size:18rpx; }
.reward-mini-image { position:relative; width:180rpx; height:205rpx; margin-top:18rpx; }
.reward-mini-title { position:relative; max-width:100%; margin-top:14rpx; color:#5b524b; font-family:serif; font-size:25rpx; text-align:center; overflow-wrap:anywhere; }
.reward-mini-from { position:absolute; bottom:22rpx; color:#8c8278; font-size:18rpx; }

.reward-effects { position:absolute; inset:0; z-index:1; overflow:hidden; pointer-events:none; contain:layout paint; }
.reward-effect-position { position:absolute; left:50%; transform:translate(-50%,-50%); }
.reward-effect-image { display:block; width:100%; height:100%; }
.reward-rays-position { top:calc(50% - 4rpx); width:750rpx; height:1015rpx; }
.reward-confetti-position { top:50%; left:calc(50% + 7rpx); width:698rpx; height:1050rpx; }
.reward-ribbon-position { position:absolute; top:50%; width:187rpx; height:560rpx; transform:translateY(-50%); }
.reward-ribbon-left-position { top:calc(50% - 41rpx); left:0; }
.reward-ribbon-right-position { top:calc(50% - 50rpx); right:0; }
.reward-rays { opacity:0; animation:reward-rays-burst 1100ms 160ms cubic-bezier(.22,1,.36,1) both; }
.reward-confetti { opacity:0; animation:reward-confetti-fall 1900ms 250ms cubic-bezier(.22,.75,.25,1) both; }
.reward-ribbon { opacity:0; animation-duration:1650ms; animation-delay:230ms; animation-timing-function:cubic-bezier(.22,1,.36,1); animation-fill-mode:both; }
.reward-ribbon-left { animation-name:reward-ribbon-left-release; }
.reward-ribbon-right { animation-name:reward-ribbon-right-release; }

.reward-motion-entering { animation:reward-overlay-enter 360ms ease-out both; }
.reward-motion-entering .reward-card-stack,
.reward-motion-entering .reward-batch-panel { transform-origin:center center; animation:reward-card-pop var(--reward-entry-duration) cubic-bezier(.22,1,.36,1) both; will-change:transform,opacity; }
.reward-motion-entering .reward-preview-badge { animation:reward-control-enter 260ms 170ms ease-out both; }
.reward-motion-flipping .reward-card { will-change:transform; }
.reward-motion-flipping .reward-finish-button,
.reward-motion-flipping .reward-batch-title { animation:reward-control-enter 260ms 500ms ease-out both; }
.reward-motion-advancing .reward-card-stack { pointer-events:none; transform-origin:center center; animation:reward-card-collapse var(--reward-advance-duration) cubic-bezier(.55,0,1,.45) both; will-change:transform,opacity; }
.reward-motion-advancing .reward-open-button,
.reward-motion-advancing .reward-preview-badge { animation:reward-control-exit 160ms ease-in both; }
.reward-motion-closing { pointer-events:none; animation:reward-overlay-close var(--reward-close-duration) ease-in both; }
.reward-motion-closing .reward-dialog { animation:reward-dialog-dismiss var(--reward-close-duration) ease-in both; will-change:transform,opacity; }
.reward-motion-collecting { pointer-events:none; animation:reward-overlay-collect var(--reward-collect-duration) linear both; }
.reward-motion-collecting .reward-card-stack,
.reward-motion-collecting .reward-batch-panel { transform-origin:center center; animation:reward-card-collect var(--reward-collect-duration) cubic-bezier(.4,0,.65,1) both; will-change:transform,opacity; }
.reward-motion-collecting .reward-dialog-close,
.reward-motion-collecting .reward-preview-badge,
.reward-motion-collecting .reward-open-button,
.reward-motion-collecting .reward-stack-tip,
.reward-motion-collecting .reward-batch-title { animation:reward-control-exit 160ms ease-in both; }

@keyframes reward-overlay-enter {
  from { opacity:0; }
  to { opacity:1; }
}

@keyframes reward-card-pop {
  0% { opacity:0; transform:scale(.06); }
  1% { opacity:1; transform:scale(.06); }
  65% { opacity:1; transform:scale(1.025); }
  84% { opacity:1; transform:scale(.99); }
  100% { opacity:1; transform:scale(1); }
}

@keyframes reward-control-enter {
  from { opacity:0; transform:translateY(12rpx); }
  to { opacity:1; transform:translateY(0); }
}

@keyframes reward-control-exit {
  from { opacity:1; }
  to { opacity:0; }
}

@keyframes reward-card-collapse {
  0% { opacity:1; transform:scale(1); }
  20% { opacity:1; transform:scale(1.015); }
  100% { opacity:0; transform:scale(.06); }
}

@keyframes reward-dialog-dismiss {
  from { opacity:1; transform:scale(1); }
  to { opacity:0; transform:scale(.94); }
}

@keyframes reward-overlay-close {
  from { opacity:1; }
  to { opacity:0; }
}

@keyframes reward-overlay-collect {
  0%,64% { opacity:1; }
  100% { opacity:0; }
}

@keyframes reward-card-collect {
  0% { opacity:1; transform:translate3d(0,0,0) scale(1); }
  9% { opacity:1; transform:translate3d(0,0,0) scale(.99); }
  18% { opacity:1; transform:translate3d(0,0,0) scale(1.025); }
  38%,46% { opacity:1; transform:translate3d(0,0,0) scale(.06); }
  100% { opacity:0; transform:translate3d(0,72vh,0) scale(.04); }
}

@keyframes reward-rays-burst {
  0% { opacity:0; transform:scale(.55) rotate(-5deg); }
  18% { opacity:.9; }
  58% { opacity:.72; }
  100% { opacity:0; transform:scale(1.08) rotate(3deg); }
}

@keyframes reward-ribbon-left-release {
  0% { opacity:0; transform:translate3d(90rpx,-24rpx,0) scale(.72); }
  18% { opacity:1; transform:translate3d(0,0,0) scale(1); }
  72% { opacity:1; transform:translate3d(-8rpx,48rpx,0) scale(1); }
  100% { opacity:0; transform:translate3d(-16rpx,120rpx,0) scale(.96); }
}

@keyframes reward-ribbon-right-release {
  0% { opacity:0; transform:translate3d(-90rpx,-24rpx,0) scale(.72); }
  18% { opacity:1; transform:translate3d(0,0,0) scale(1); }
  72% { opacity:1; transform:translate3d(8rpx,48rpx,0) scale(1); }
  100% { opacity:0; transform:translate3d(16rpx,120rpx,0) scale(.96); }
}

@keyframes reward-confetti-fall {
  0% { opacity:0; transform:translate3d(0,-80rpx,0) scale(.45) rotate(-4deg); }
  16% { opacity:1; transform:translate3d(0,0,0) scale(1) rotate(0); }
  66% { opacity:1; transform:translate3d(0,48rpx,0) scale(1) rotate(2deg); }
  100% { opacity:0; transform:translate3d(0,170rpx,0) scale(1.02) rotate(5deg); }
}

@media (prefers-reduced-motion: reduce) {
  .reward-overlay,
  .reward-dialog,
  .reward-card-stack,
  .reward-batch-panel,
  .reward-preview-badge,
  .reward-open-button,
  .reward-card { animation-duration:1ms !important; animation-delay:0ms !important; transition-duration:1ms !important; }
  .reward-effects { display:none; }
}
