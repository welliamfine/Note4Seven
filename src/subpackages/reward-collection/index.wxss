page { background:#fffcf7; color:#5b524b; }
.reward-collection-page { min-height:100vh; padding:0 34rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.collection-nav { height:88rpx; display:grid; grid-template-columns:64rpx 1fr 64rpx; align-items:center; text-align:center; font-size:var(--font-size-title); }
.collection-back { width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(255,255,255,.68); box-shadow:0 5rpx 14rpx rgba(64,51,43,.06); }
.collection-back image { width:24rpx; height:24rpx; opacity:.66; }
.collection-count { color:#8c8278; font-size:var(--font-size-caption); text-align:right; }
.collection-filters { margin:28rpx 0 32rpx; display:grid; grid-template-columns:repeat(3,1fr); gap:10rpx; }
.collection-filters view { height:68rpx; display:flex; align-items:center; justify-content:center; border-radius:22rpx; background:rgba(255,255,255,.62); color:#8c8278; font-size:var(--font-size-caption); }
.collection-filters .active { background:rgba(242,214,209,.82); color:#5b524b; box-shadow:inset 0 2rpx 0 rgba(255,255,255,.72); }
.collection-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }
.collection-card { position:relative; min-width:0; height:440rpx; padding:25rpx 18rpx 20rpx; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; overflow:hidden; border:1rpx solid rgba(255,255,255,.72); border-radius:28rpx; background:#fffcf7; box-shadow:0 14rpx 28rpx rgba(56,46,38,.12),inset 0 8rpx 18rpx rgba(255,255,255,.3); }
.collection-card-gift { border-color:rgba(212,171,163,.55); }
.collection-texture { position:absolute; inset:0; width:100%; height:100%; opacity:.15; }
.collection-code { position:relative; width:100%; display:flex; justify-content:space-between; color:#c4948f; font-family:serif; font-size:var(--font-size-caption); }
.collection-kicker { position:relative; margin-top:20rpx; color:#5b524b; font-family:serif; font-size:var(--font-size-secondary); }
.collection-image { position:relative; width:176rpx; height:190rpx; margin-top:14rpx; filter:drop-shadow(0 8rpx 14rpx rgba(64,51,43,.12)); }
.collection-title { position:relative; max-width:100%; margin-top:12rpx; color:#5b524b; font-family:serif; font-size:var(--font-size-body); line-height:1.25; text-align:center; overflow-wrap:anywhere; }
.collection-description { position:relative; width:100%; margin-top:6rpx; color:#8c8278; font-size:var(--font-size-secondary); line-height:1.3; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.collection-date { position:absolute; bottom:14rpx; color:#8c8278; font-family:serif; font-size:var(--font-size-caption); }
.collection-empty { min-height:55vh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16rpx; color:#8c8278; font-size:var(--font-size-secondary); }
.collection-empty-icon { position:relative; width:96rpx; height:96rpx; overflow:hidden; }
.collection-empty-icon image { position:absolute; top:0; left:0; width:192rpx; max-width:none; height:96rpx; }
