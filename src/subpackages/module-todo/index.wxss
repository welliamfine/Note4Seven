@import "../../styles/beta.wxss";
.todo-body { padding-top:4rpx; }.todo-list { display:flex; flex-direction:column; gap:20rpx; }.todo-card { position:relative; min-height:170rpx; padding:26rpx 28rpx; box-sizing:border-box; }
.todo-head { position:relative; min-height:42rpx; padding-right:44rpx; display:flex; align-items:center; }.todo-type { color:var(--text-color-primary); font-size:var(--font-size-body); line-height:var(--line-height-normal); }.todo-dot { position:absolute; top:50%; right:8rpx; width:14rpx; height:14rpx; border-radius:50%; background:var(--signal-red); transform:translateY(-50%); }.todo-content { display:block; margin-top:10rpx; color:var(--text-color-muted); font-size:var(--font-size-secondary); line-height:var(--line-height-normal); }.todo-date { display:block; margin-top:12rpx; color:var(--text-color-muted); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }
.todo-sticker { position:absolute; right:24rpx; top:54rpx; width:90rpx; height:90rpx; }.todo-sticker image { width:100%; height:100%; }.todo-actions { width:100%; margin-top:22rpx; box-sizing:border-box; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14rpx; }.todo-actions button { width:100%; min-width:0; height:68rpx; margin:0; padding:0; box-sizing:border-box; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:34rpx; background:rgba(255,255,255,.52); color:var(--text-color-primary); font-size:var(--font-size-secondary); font-weight:var(--font-weight-regular); line-height:var(--line-height-normal); }.todo-actions .approve { background:#d7c2ae; color:#fff; }.todo-result { display:block; margin-top:16rpx; color:var(--text-color-muted); line-height:var(--line-height-normal); text-align:right; }
