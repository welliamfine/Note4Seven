<view class="publish-page">
  <image class="page-texture" src="/assets/ui/material-texture.jpg" mode="aspectFill" aria-hidden="true" />
  <view class="publish-header content-layer" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-control" bindtap="goBack" role="button" aria-label="返回"><image src="/assets/ui/icons/chevron-left.svg" /></view>
    <text>{{mode === 'recruitment' ? '发布招募' : '分享到发现'}}</text>
    <view class="header-control header-placeholder"></view>
  </view>

  <scroll-view class="publish-scroll content-layer" style="top: calc({{statusBarHeight}}px + 104rpx); height: calc(100vh - {{statusBarHeight}}px - 104rpx);" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="publish-content">
      <view wx:if="{{loading}}" class="publish-state">正在准备公开快照</view>
      <view wx:elif="{{errorMessage}}" class="publish-state"><text>{{errorMessage}}</text><view bindtap="retryLoad" role="button">重新检查</view></view>
      <block wx:else>
        <view wx:if="{{mode === 'recruitment'}}" class="preview-card recruitment-preview">
          <text class="preview-kicker">公开招募</text>
          <text class="preview-title">{{recruitment.moduleName}}</text>
          <text wx:if="{{recruitment.moduleDescription}}" class="preview-copy">{{recruitment.moduleDescription}}</text>
          <view class="recruitment-counts"><text>{{recruitment.memberCount}} / {{recruitment.memberLimit}} 人</text><text>还可加入 {{recruitment.openSlots}} 人</text></view>
        </view>

        <view wx:elif="{{source.postType === 'record'}}" class="preview-card record-preview">
          <image class="preview-record sticker-outline-large" src="{{snapshot.stickerUrl}}" mode="aspectFit" />
          <view><text>{{snapshot.moduleName}}</text><text>{{snapshot.recordDate}}</text></view>
        </view>

        <view wx:elif="{{source.postType === 'calendar'}}" class="preview-card calendar-preview">
          <view class="calendar-head"><text class="preview-title">{{snapshot.moduleName}}</text><text>{{snapshot.month}}</text></view>
          <view class="weekday-row"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view>
          <view class="calendar-grid">
            <view class="calendar-cell" wx:for="{{calendarCells}}" wx:key="key"><text>{{item.day}}</text><image wx:for="{{item.records}}" wx:for-item="record" wx:key="stickerUrl" class="sticker-outline-small" src="{{record.stickerUrl}}" mode="aspectFit" /></view>
          </view>
        </view>

        <view wx:elif="{{source.postType === 'board'}}" class="preview-card board-preview">
          <image wx:if="{{snapshot.boardUrl}}" class="board-bg" src="{{snapshot.boardUrl}}" mode="scaleToFill" />
          <view class="board-item" wx:for="{{boardItems}}" wx:key="zIndex" style="{{item.style}}"><image src="{{item.imageUrl}}" mode="aspectFit" /></view>
        </view>

        <view wx:elif="{{source.postType === 'easter_egg'}}" class="preview-card egg-preview">
          <view><text class="preview-kicker">{{snapshot.stage === 'redeemed' ? '已经兑换' : '刚刚解锁'}}</text><text class="preview-title">{{snapshot.title}}</text><text class="preview-copy">来自 {{snapshot.sponsorName}}</text></view>
          <image wx:if="{{snapshot.stickerUrl || snapshot.coverUrl}}" class="sticker-outline-medium" src="{{snapshot.stickerUrl || snapshot.coverUrl}}" mode="aspectFit" />
          <image wx:else src="/assets/ui/icons/sparkles.svg" mode="aspectFit" />
        </view>

        <view class="editor-section">
          <text class="editor-label">{{mode === 'recruitment' ? '招募说明' : '公开文字'}}</text>
          <textarea class="public-editor" value="{{publicText}}" bindinput="updatePublicText" maxlength="{{mode === 'recruitment' ? 300 : 500}}" auto-height placeholder="{{mode === 'recruitment' ? '说说希望和怎样的人一起记录' : '可以补充一段仅用于公开动态的文字'}}" placeholder-class="text-placeholder" />
          <text class="editor-count">{{publicText.length}} / {{mode === 'recruitment' ? 300 : 500}}</text>
        </view>

        <view wx:if="{{mode === 'recruitment'}}" class="duration-section">
          <text class="editor-label">招募时长</text>
          <view class="duration-segment">
            <view class="{{durationDays === 1 ? 'selected' : ''}}" data-days="1" bindtap="chooseDuration" role="button">24 小时</view>
            <view class="{{durationDays === 3 ? 'selected' : ''}}" data-days="3" bindtap="chooseDuration" role="button">3 天</view>
            <view class="{{durationDays === 7 ? 'selected' : ''}}" data-days="7" bindtap="chooseDuration" role="button">7 天</view>
          </view>
        </view>

        <view class="privacy-warning {{source.postType === 'calendar' ? 'calendar-warning' : ''}}">
          <image src="/assets/ui/icons/shield.svg" mode="aspectFit" />
          <text wx:if="{{mode === 'recruitment'}}">招募页只公开模块名称、说明、记录方式和人数，不公开成员、日历、贴纸与历史记录。</text>
          <text wx:else>{{privacyNotice}}</text>
        </view>

        <view class="publish-action {{publishing ? 'disabled' : ''}}" bindtap="publish" role="button">{{publishing ? '正在发布' : '确认发布'}}</view>
      </block>
      <view class="bottom-space"></view>
    </view>
  </scroll-view>
</view>
<privacy-dialog />
