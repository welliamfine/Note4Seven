.publish-page { min-height: 100vh; background: #f9f8f3; color: var(--text-color-primary); }
.publish-header { position: fixed; top: 0; right: 0; left: 0; z-index: 10; height: 104rpx; display: grid; grid-template-columns: 80rpx 1fr 80rpx; align-items: center; text-align: center; background: rgba(249,248,243,.9); backdrop-filter: blur(18px); font-size: var(--font-size-title); }
.header-control { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; }
.header-control image { width: 38rpx; height: 38rpx; }
.publish-scroll { position: fixed; right: 0; left: 0; }
.publish-content { padding: 24rpx 28rpx 0; }
.publish-state { min-height: 600rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; color: var(--text-color-muted); font-size: var(--font-size-secondary); }
.preview-card { overflow: hidden; border-radius: 16rpx; background: rgba(255,255,255,.76); box-shadow: var(--shadow); }
.preview-kicker { color: var(--text-color-muted); font-size: var(--font-size-secondary); }
.preview-title { font-size: var(--font-size-title); line-height: var(--line-height-tight); }
.preview-copy { color: var(--text-color-muted); font-size: var(--font-size-secondary); line-height: var(--line-height-relaxed); }
.recruitment-preview { padding: 36rpx; display: flex; flex-direction: column; gap: 16rpx; }
.recruitment-counts { margin-top: 14rpx; display: flex; justify-content: space-between; color: var(--text-color-muted); font-size: var(--font-size-secondary); }
.record-preview { position: relative; height: 500rpx; background: #f2e8e1; }
.preview-record { width: 100%; height: 420rpx; }
.record-preview > view { position: absolute; right: 26rpx; bottom: 20rpx; left: 26rpx; display: flex; justify-content: space-between; color: var(--text-color-muted); font-size: var(--font-size-secondary); }
.calendar-preview { padding: 28rpx 20rpx 22rpx; background: #f8f4ef; }
.calendar-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }
.calendar-head > text:last-child { color: var(--text-color-muted); font-family: var(--font-family-data); font-size: var(--font-size-secondary); }
.weekday-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.weekday-row text { padding-bottom: 10rpx; text-align: center; color: var(--text-color-muted); font-size: var(--font-size-caption); }
.calendar-cell { position: relative; height: 76rpx; border-top: 1rpx solid rgba(120,108,97,.1); color: var(--text-color-muted); font-family: var(--font-family-data); font-size: var(--font-size-caption); }
.calendar-cell image { position: absolute; right: 4rpx; bottom: 4rpx; width: 38rpx; height: 38rpx; }
.board-preview { position: relative; height: 620rpx; background: #eee3d8; }
.board-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
.board-item { position: absolute; }
.board-item image { width: 100%; height: 100%; }
.egg-preview { min-height: 290rpx; padding: 34rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; background: #f7e4e1; }
.egg-preview > view { display: flex; flex-direction: column; gap: 12rpx; }
.egg-preview > image { width: 190rpx; height: 190rpx; flex: 0 0 190rpx; }
.editor-section, .duration-section { margin-top: 24rpx; padding: 28rpx; border-radius: 16rpx; background: rgba(255,255,255,.7); }
.editor-label { display: block; margin-bottom: 18rpx; font-size: var(--font-size-body); }
.public-editor { width: 100%; min-height: 150rpx; color: var(--text-color-primary); font-family: var(--font-family-base); font-size: var(--font-size-secondary); font-weight: var(--font-weight-regular); line-height: var(--line-height-relaxed); }
.editor-count { display: block; margin-top: 10rpx; text-align: right; color: var(--text-color-muted); font-size: var(--font-size-caption); }
.duration-segment { height: 76rpx; padding: 6rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6rpx; border-radius: 8rpx; background: rgba(153,145,136,.1); }
.duration-segment view { display: flex; align-items: center; justify-content: center; border-radius: 6rpx; color: var(--text-color-muted); font-size: var(--font-size-secondary); }
.duration-segment view.selected { background: #fff; color: var(--text-color-primary); box-shadow: 0 4rpx 12rpx rgba(86,72,57,.08); }
.privacy-warning { margin-top: 24rpx; padding: 24rpx; display: flex; align-items: flex-start; gap: 16rpx; color: var(--text-color-muted); font-size: var(--font-size-secondary); line-height: var(--line-height-relaxed); }
.privacy-warning image { width: 34rpx; height: 34rpx; flex: 0 0 34rpx; margin-top: 2rpx; }
.calendar-warning { color: var(--signal-red); }
.publish-action { height: 98rpx; margin-top: 16rpx; display: flex; align-items: center; justify-content: center; border-radius: 8rpx; background: #e3ada9; color: #fff; font-size: var(--font-size-body); }
.publish-action.disabled { background: rgba(153,145,136,.16); color: var(--text-color-muted); }
.bottom-space { height: calc(42rpx + env(safe-area-inset-bottom)); }
