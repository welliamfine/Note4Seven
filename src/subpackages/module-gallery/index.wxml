<view class="page-shell beta-page gallery-page" style="padding-top:{{statusBarHeight}}px;">
  <image class="page-texture" src="/assets/ui/material-texture.jpg" mode="aspectFill" />
  <view class="beta-topbar content-layer"><text class="brand-script beta-brand">Note4Seven</text><view class="beta-heading"><view class="beta-back" bindtap="goBack"><image src="/assets/ui/icons/chevron-left.svg" /></view><text class="beta-heading-title">图片展示</text><view></view></view></view>
  <view class="gallery-month content-layer"><view bindtap="previousMonth"><image src="/assets/ui/icons/chevron-left.svg" /></view><text>{{monthLabel}}</text><view class="{{canNext ? '' : 'disabled'}}" bindtap="nextMonth"><image src="/assets/ui/icons/chevron-right.svg" /></view></view>
  <scroll-view class="beta-scroll content-layer" scroll-y enhanced show-scrollbar="{{false}}"><view class="beta-body gallery-body">
    <view wx:if="{{loading}}" class="beta-loading">正在整理这个月的照片...</view>
    <view wx:elif="{{!view.items.length}}" class="beta-empty beta-glass"><image src="/assets/ui/icons/images.svg" /><text>这个月还没有照片</text></view>
    <view wx:else class="gallery-grid"><view class="gallery-card beta-glass" wx:for="{{view.items}}" wx:key="recordId" data-id="{{item.recordId}}" bindtap="selectItem"><view class="gallery-sticker"><view class="sticker-pop-wrapper {{item.syncPhase || stickerPhase}}" style="animation-delay: {{stickerPhase === 'sticker-entering' ? item.popDelay : 0}}ms;"><image class="sticker-outline-medium" src="{{item.stickerPath}}" mode="aspectFit" webp /></view></view><view class="gallery-meta"><text>{{item.recordDate}}</text><text>{{item.displayName}}</text></view></view></view>
  </view></scroll-view>
  <view wx:if="{{selected}}" class="beta-overlay sheet-motion-overlay {{previewClosing ? 'sheet-motion-closing' : ''}}" bindtap="closePreview"><view class="beta-sheet gallery-sheet sheet-motion-panel {{previewClosing ? 'sheet-motion-closing' : ''}}" catchtap="stopPropagation"><view class="beta-handle"></view><view class="preview-owner"><view class="beta-avatar" style="background:{{selected.avatarColor}};"><image wx:if="{{selected.avatarUrl}}" src="{{selected.avatarUrl}}" mode="aspectFill" /><text wx:else>{{selected.avatarText}}</text></view><view><text>{{selected.displayName}}</text><text>{{selected.recordDate}}</text></view></view><image class="preview-original sticker-outline-large" src="{{selected.stickerPath}}" mode="aspectFit" webp bindtap="previewOriginal" /><text wx:if="{{selected.remark}}" class="preview-remark">{{selected.remark}}</text><view class="preview-actions"><button class="beta-secondary bottom-action-button" loading="{{previewingSticker}}" disabled="{{previewingSticker}}" bindtap="previewOriginal">预览贴纸</button><button class="beta-primary bottom-action-button" bindtap="openDate">查看这一天</button></view></view></view>
  <canvas canvas-id="stickerPreviewCanvas" class="sticker-preview-canvas"></canvas>
</view>
<privacy-dialog />
