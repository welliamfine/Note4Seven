@import "../../styles/beta.wxss";
.gallery-month { flex:0 0 82rpx; margin:0 36rpx 10rpx; display:grid; grid-template-columns:70rpx 1fr 70rpx; align-items:center; border-radius:32rpx; background:rgba(255,255,255,.4); backdrop-filter:blur(30px); }
.gallery-month > view { width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; }.gallery-month image { width:24rpx; height:24rpx; opacity:.65; }.gallery-month text { color:var(--text-color-primary); font-family:var(--font-family-data); font-size:var(--font-size-body); font-weight:var(--font-weight-regular); line-height:var(--line-height-normal); text-align:center; }
.gallery-month .disabled { opacity:.25; }
.gallery-body { padding-top:8rpx; }.gallery-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:22rpx; }.gallery-card { min-width:0; height:264rpx; padding:15rpx; box-sizing:border-box; overflow:hidden; border-radius:34rpx; }.gallery-sticker { height:188rpx; display:flex; align-items:center; justify-content:center; }.gallery-sticker image { width:100%; height:100%; }.gallery-meta { display:flex; justify-content:space-between; gap:8rpx; color:var(--text-color-muted); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }.gallery-meta text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.beta-empty image { width:56rpx; height:56rpx; margin-bottom:18rpx; opacity:.4; }
.gallery-sheet { max-height:82vh; }.preview-owner { display:flex; align-items:center; gap:16rpx; }.preview-owner > view:last-child { display:flex; flex-direction:column; gap:4rpx; }.preview-owner > view:last-child text:last-child { color:var(--text-color-muted); font-size:var(--font-size-caption); line-height:var(--line-height-normal); }.preview-original { width:100%; height:440rpx; margin-top:18rpx; }.preview-remark { display:block; margin:10rpx 4rpx 18rpx; color:var(--text-color-primary); font-size:var(--font-size-secondary); line-height:var(--line-height-normal); }.preview-actions { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }.preview-actions button { height:82rpx; line-height:var(--line-height-normal); }
.sticker-preview-canvas { position:fixed; left:-2000px; top:0; width:750px; height:1000px; pointer-events:none; }
