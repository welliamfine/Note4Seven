<view class="page-shell beta-page" style="padding-top:{{statusBarHeight}}px;"><image class="page-texture" src="/assets/ui/material-texture.jpg" mode="aspectFill" /><view class="beta-topbar content-layer"><text class="brand-script beta-brand">NoteMyLife</text><view class="beta-heading"><view class="beta-back" bindtap="goBack"><image src="/assets/ui/icons/chevron-left.svg" /></view><text class="beta-heading-title">模块回收站</text><view></view></view></view><scroll-view class="beta-scroll content-layer" scroll-y enhanced show-scrollbar="{{false}}"><view class="beta-body"><view wx:if="{{loading}}" class="beta-loading">正在加载...</view><view wx:elif="{{!items.length}}" class="beta-empty beta-glass"><image src="/assets/ui/icons/archive-restore.svg" /><text>回收站是空的</text></view><view wx:else class="recycle-list"><view class="recycle-card beta-glass" wx:for="{{items}}" wx:key="moduleId"><view class="recycle-icon"><image src="/assets/ui/icons/trash-2.svg" /></view><view class="recycle-copy"><text>{{item.name}}</text><text>{{item.memberCount}}人 · 剩余{{item.remainingDays}}天</text><text>到期后记录和图片将永久删除</text></view><button data-id="{{item.moduleId}}" loading="{{restoringId === item.moduleId}}" bindtap="restore">恢复</button></view></view></view></scroll-view></view>
<privacy-dialog />
