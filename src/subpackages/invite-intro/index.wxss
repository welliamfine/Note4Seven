@import "../../styles/beta.wxss";
.intro-card { min-height:600rpx; padding:46rpx 40rpx; display:flex; flex-direction:column; align-items:center; box-sizing:border-box; text-align:center; }
.intro-illustration { width:180rpx; height:220rpx; }.intro-name { margin-top:14rpx; color:var(--text-color-primary); font-size:var(--font-size-title); font-weight:var(--font-weight-regular); line-height:var(--line-height-tight); }.intro-copy { margin-top:18rpx; color:var(--text-color-muted); font-size:var(--font-size-secondary); line-height:var(--line-height-relaxed); }
.intro-inviter { margin-top:45rpx; display:flex; align-items:center; gap:18rpx; }.intro-count { margin-top:30rpx; color:var(--text-color-muted); font-size:var(--font-size-secondary); line-height:var(--line-height-normal); }
.result-card { margin-top:22rpx; padding:26rpx; color:var(--text-color-muted); font-size:var(--font-size-secondary); line-height:var(--line-height-normal); text-align:center; }
