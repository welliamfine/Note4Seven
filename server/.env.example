# Safe template only. Copy to server/.env (ignored) and inject real secrets through the deployment platform.
NODE_ENV=production
APP_ENV=<staging-or-production>
RELEASE_ID=<release-id>
PORT=8080
APP_ID=<wechat-app-id>
WECHAT_CLOUD_ENV_ID=<target-cloud-environment-id>
WECHAT_CLOUD_SERVICE=<target-service-name>
MYSQL_ADDRESS=<internal-mysql-host>:3306
MYSQL_USERNAME=<runtime-dml-user>
MYSQL_PASSWORD=<secret>
MYSQL_DATABASE=record_life
DB_POOL_LIMIT=10
OBJECT_BUCKET=<target-private-bucket>
COS_REGION=ap-shanghai
AUTO_MIGRATE=false
ALLOW_DEV_AUTH=false
LOG_LEVEL=info
SESSION_TTL_SECONDS=7200
WECHAT_OPEN_API_BASE=http://api.weixin.qq.com
# Use trial before filing/public release; switch to release when the formal version goes live.
MINI_PROGRAM_CODE_ENV_VERSION=trial
PRIVACY_VERSION=1.0.0

# Enable only after each integration is configured and verified in the target environment.
ENABLE_WECHAT_CALLBACK=false
WECHAT_CALLBACK_TOKEN=
WECHAT_CALLBACK_TOKEN_PREVIOUS=
ENABLE_STORAGE_EVENTS=false
STORAGE_EVENT_TOKEN=
STORAGE_EVENT_TOKEN_PREVIOUS=
ENABLE_SUBSCRIPTIONS=false
SUBSCRIBE_TEMPLATE_ID=
SUBSCRIBE_THING_KEY=thing1
SUBSCRIBE_TIME_KEY=time2
SUBSCRIBE_NOTE_KEY=thing3
ENABLE_METRICS=false
METRICS_TOKEN=
ENABLE_ANALYTICS=false
ANALYTICS_HASH_SALT=

# Backup/migration jobs should inject a separate account with BACKUP/DDL privileges.
# MIGRATION_MYSQL_USERNAME=<migration-user>
# MIGRATION_MYSQL_PASSWORD=<secret>
