# Non-secret application settings
NODE_ENV=development
PORT=8080
APP_ID=wxa64faf2abab7e388
WECHAT_CLOUD_ENV_ID=prod-d5g4tznceeecbaf39
WECHAT_CLOUD_SERVICE=express-bonj
MYSQL_DATABASE=record_life
OBJECT_BUCKET=7072-prod-d5g4tznceeecbaf39-1346314817
COS_REGION=ap-shanghai
SUBSCRIBE_TEMPLATE_ID=fTNBBNLftez9i-ZcduqQ98r3az3IE2IZOWGLqnyUT5s
# Confirmed template fields: activity name, reminder time, check-in status.
SUBSCRIBE_THING_KEY=thing1
SUBSCRIBE_TIME_KEY=time2
SUBSCRIBE_NOTE_KEY=thing3
AUTO_MIGRATE=true
LOG_LEVEL=info
WECHAT_OPEN_API_BASE=http://api.weixin.qq.com
PRIVACY_VERSION=1.0.0
# Generated during deployment; use the same value in the WeChat message callback configuration.
WECHAT_CALLBACK_TOKEN=
# Shared only with the COS trigger function that forwards ObjectCreated events.
STORAGE_EVENT_TOKEN=

# Legacy WeChat Cloud Hosting injects these values automatically.
# For local development only, put real values in server/.env (ignored by git).
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Current CloudBase consoles may expose the same connection as DB_* instead.
# Use either MYSQL_* above or DB_* below; do not put real credentials in this file.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=record_life

# Never enable this in production. It permits X-Dev-OpenId for local tests.
ALLOW_DEV_AUTH=false
