{
  "name": "note-my-life-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "description": "记录我的一辈子 - 微信云托管生产后端",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrations:write-manifest": "node scripts/migrations-manifest.mjs --write",
    "migrations:check": "node scripts/migrations-manifest.mjs --check",
    "db:check-invariants": "node scripts/check-invariants.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "node scripts/integration-smoke.mjs",
    "openapi:write": "node scripts/openapi.mjs --write",
    "openapi:check": "node scripts/openapi.mjs --check",
    "deploy": "node scripts/deploy.mjs",
    "verify": "npm run typecheck && npm run test && npm run openapi:check && npm run migrations:check && npm run build"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
