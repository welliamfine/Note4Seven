NODE_ENV=development
APP_ENV=development
RELEASE_ID=local-development
PORT=8080
APP_ID=local-development-app
WECHAT_CLOUD_ENV_ID=local-development
WECHAT_CLOUD_SERVICE=local-backend
MYSQL_ADDRESS=127.0.0.1:3307
MYSQL_USERNAME=root
MYSQL_PASSWORD=local-dev-password
MYSQL_DATABASE=record_life
DB_POOL_LIMIT=10
OBJECT_BUCKET=local-development
COS_REGION=ap-shanghai
AUTO_MIGRATE=true
ALLOW_DEV_AUTH=true
LOG_LEVEL=debug
SESSION_TTL_SECONDS=86400
WECHAT_OPEN_API_BASE=http://api.weixin.qq.com
PRIVACY_VERSION=1.0.0
ENABLE_WECHAT_CALLBACK=false
ENABLE_STORAGE_EVENTS=false
ENABLE_SUBSCRIPTIONS=false
ENABLE_METRICS=false
ENABLE_ANALYTICS=false
LOCAL_STORAGE_PATH=.local-storage
LOCAL_PUBLIC_BASE_URL=http://127.0.0.1:8080
