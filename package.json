{
  "name": "note-my-life-miniprogram",
  "version": "0.3.0-rc.1",
  "private": true,
  "description": "记录我的一辈子 - 微信小程序 RC",
  "scripts": {
    "build": "node scripts/build.mjs --api-mode=remote",
    "build:mock": "node scripts/build.mjs --api-mode=local",
    "build:local-backend": "node scripts/build.mjs --api-mode=dev-server",
    "build:production": "node scripts/build.mjs --api-mode=remote",
    "dev": "node scripts/build.mjs --watch --api-mode=remote",
    "dev:cloud": "node scripts/build.mjs --watch --api-mode=remote",
    "dev:mock": "node scripts/build.mjs --watch --api-mode=local",
    "dev:local-backend": "node scripts/start-local-dev.mjs",
    "local:down": "docker compose -f server/docker-compose.dev.yml down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build && node scripts/validate-project.mjs",
    "verify:production": "npm run typecheck && npm run test && npm run build:production && node scripts/validate-project.mjs && node scripts/validate-production.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lucide-static": "^1.24.0",
    "miniprogram-api-typings": "^4.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
