{
  "name": "note-my-life-miniprogram",
  "version": "0.3.0-rc.1",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "description": "记录我的一辈子 - 微信小程序 RC",
  "scripts": {
    "build": "node scripts/build.mjs --api-mode=remote --target-environment=production",
    "build:mock": "node scripts/build.mjs --api-mode=local --target-environment=development",
    "build:local-backend": "node scripts/build.mjs --api-mode=dev-server --target-environment=development",
    "build:staging": "node scripts/build.mjs --api-mode=remote --target-environment=staging",
    "build:production": "node scripts/build.mjs --api-mode=remote --target-environment=production",
    "dev": "npm run dev:mock",
    "dev:cloud": "node scripts/build.mjs --watch --api-mode=remote --target-environment=staging",
    "dev:mock": "node scripts/build.mjs --watch --api-mode=local --target-environment=development",
    "dev:local-backend": "node scripts/start-local-dev.mjs",
    "local:down": "docker compose -f server/docker-compose.dev.yml down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "node scripts/check-quality.mjs",
    "ci:install": "node scripts/install-all.mjs",
    "verify:all": "npm run verify && npm --prefix server run verify && npm --prefix cloudfunctions/cos-media-trigger run verify",
    "release:build": "node scripts/release.mjs",
    "cloud:check-drift": "node scripts/check-cloud-drift.mjs",
    "capacity:model": "node scripts/capacity-model.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && node scripts/validate-project.mjs",
    "verify:production": "npm run typecheck && npm run test && npm run build:production && node scripts/validate-project.mjs && node scripts/validate-production.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "lucide-static": "^1.27.0",
    "miniprogram-api-typings": "^5.2.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
