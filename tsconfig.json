{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings", "vitest/globals", "node"],
    "lib": ["ES2020", "DOM"],
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
